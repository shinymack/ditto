{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ditto",
  "version": "0.1.0",
  "identifier": "com.shinymack.ditto",
  "build": {
    "beforeDevCommand": {
      "script": "bun run dev",
      "cwd": "../app"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "bun run build",
      "cwd": "../app"
    },
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ditto",
        "url": "index.html",
        "width": 800,
        "height": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": false
      },
      {
        "label": "settings",
        "title": "Ditto Settings",
        "url": "index.html",
        "width": 550,
        "height": 450,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
